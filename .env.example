# Copy to .env to override Docker Compose defaults.
BACKEND_PORT=8000
FRONTEND_PORT=3000
MODEL_DIR=./ai_model/output/run_gpu01
VISION_MODEL_DIR=./ai_model/output/vision
# Profile parking-car resolves to the Geo-trax weights in VISION_MODEL_DIR.
# Custom models must use a path inside the container, e.g. /app/ai_model/output/vision/yolo11n.pt.
VISION_MODEL=parking-car
# Higher confidence filters out weaker detections; tune against real camera images.
VISION_CONFIDENCE=0.75
VISION_OVERLAP=0.25
VISION_IMAGE_SIZE=640
# Vote across orientations; use 0 for a faster single pass.
VISION_ROTATIONS=0,90,180,270
# Image counts exclude boxes touching the image border within this many pixels.
# Use 0 to include truncated cars. ROI-based occupancy does not apply this filter.
VISION_EDGE_MARGIN=1
CONFIG_DIR=./config
# Container path; missing parking.json leaves ROI/camera unconfigured.
ROI_CONFIG=/app/config/parking.json
# Optional physical ESP32 on the LAN. CNN reference and YOLO stay enabled.
ESP32_URL=
